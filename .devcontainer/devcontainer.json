{
  "name": "lunch-agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vsliveshare.vsliveshare"
      ]
    }
  },
  "secrets": {
    "OPENROUTER_API_KEY": {
      "description": "Used by the app's agent."
    }
  },
  "postCreateCommand": "npm run reset-db && echo 'unset ANTHROPIC_API_KEY' >> ~/.bashrc",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "App"
    }
  }
}
